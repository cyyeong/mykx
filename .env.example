# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
# On Vercel, set the same names under Project Settings → Environment Variables.

# Meta Model API: a Standard key from dev.meta.ai (server only)
MODEL_API_KEY=

# Supabase: Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…), or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…), or the legacy service_role key (server only)
SUPABASE_SECRET_KEY=

# Stretch: Baseten-hosted Muse Spark Open (server only)
BASETEN_API_KEY=
