# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
# On Vercel, set the same names under Project Settings → Environment Variables.

# Meta Model API: a Standard key from dev.meta.ai (server only)
MODEL_API_KEY=

# Supabase: Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…), or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…), or the legacy service_role key (server only)
SUPABASE_SECRET_KEY=
# Accounts: with all three Supabase values empty, `npm run dev` uses an in-memory demo family (any
# email and password signs in). A production build never does: it answers 503 until they're set.
# Add <site>/signin to Supabase → Authentication → URL Configuration → Redirect URLs (password reset).

# Signs the kid session cookie (server only, at least 32 bytes). Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
KID_SESSION_SECRET=


# Private source material lives outside the repo (raw tutor skills and the real-name map). Leave empty
# unless you are the founder re-importing a skill pack; no app code needs it.
MYKX_PRIVATE_DIR=

# The sample family's production sign-ins (never commit values): the grown-up demo@mykx.ai and the password kids,
# and the picture-code kids (four picture ids, comma-separated). Applied by scripts/set-demo-secrets.ts.
DEMO_PASSWORD=
DEMO_PICTURE_CODE=
